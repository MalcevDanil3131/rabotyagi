{
    email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
    encode zstd gzip

    @api path /api /api/*
    handle @api {
        request_body {
            max_size 45MB
        }
        reverse_proxy api:8080
    }

    @assets path /assets/*
    handle @assets {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        root * /srv
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
